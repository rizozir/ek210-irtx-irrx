// ========= IR TX (Text + 10 Presets + Servo Mode on 'C') — stable NEC =========
#include <IRremote.h>
#include <Wire.h>
#include <hd44780.h>
#include <hd44780ioClass/hd44780_I2Cexp.h>
#include <Keypad.h>
#include <Servo.h>


hd44780_I2Cexp lcd;                 // auto-detect I2C LCD


// ======== IR (unchanged from your working setup) ========
const uint8_t  IR_PIN        = 3;      // IR LED on D3
const uint16_t IR_ADDR       = 0x0010; // must match RX
const uint8_t  IR_TEXT_START = 0xF0;
const uint8_t  IR_TEXT_END   = 0xFF;
const uint16_t INTER_CHAR_MS = 120;    // safe gap; avoids repeat-only


// ======== Presets (10 total) 0x10..0x19 ========
const uint8_t presetCmds[10] = {0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,0x18,0x19};
const char*   PRESET_TEXT[10] = {
  "DONE","WORKING ON IT","NEED HELP?","BREAK?","NOT WORKING",
  "HELP","YES","NO","GET TO WORK :)","LEAVING"
};


// ======== Keypad (your wiring) ========
const byte ROWS=4, COLS=4;
char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};
byte rowPins[ROWS]={2,4,5,6};
byte colPins[COLS]={7,8,9,10};
Keypad keypad(makeKeymap(keys),rowPins,colPins,ROWS,COLS);


// ======== Modes & multi-tap ========
enum Mode { MODE_PRESET, MODE_TEXT, MODE_SERVO };
Mode mode = MODE_PRESET;


const uint16_t MULTITAP_WINDOW_MS = 600;
const uint8_t  TEXT_MAX = 64;
char buf[TEXT_MAX+1];
uint8_t len=0;
char lastKey=0;
uint8_t cycle=0;
unsigned long lastMs=0;


const char* mapKey(char k){
  switch(k){
    case '2': return "ABC";  case '3': return "DEF";
    case '4': return "GHI";  case '5': return "JKL";
    case '6': return "MNO";  case '7': return "PQRS";
    case '8': return "TUV";  case '9': return "WXYZ";
    case '1': return ".,?!";
    default:  return nullptr;
  }
}


// ======== SERVO (local on TX) ========
const uint8_t SERVO_PIN = 11;  // free PWM pin on Uno
Servo servo;
int currentAngle = 90;         // track angle (Servo lib can't read it)


// Angle mapping for keys 1..9 in Servo Mode (tweak as you like)
const int SERVO_PRESET_ANGLES[9] = { 0, 20, 40, 60, 80, 100, 120, 140, 180 };
// Key '0' centers the servo to 90°
const int SERVO_CENTER_ANGLE = 90;
const int SERVO_NUDGE_STEP   = 5;   // * = -step, # = +step


void servoSafeWrite(int deg){
  if (deg < 0) deg = 0;
  if (deg > 180) deg = 180;
  currentAngle = deg;
  servo.write(currentAngle);
}


void servoSweepOnce(){
  for (int a=0; a<=180; a+=3){ servo.write(a); delay(8); }
  for (int a=180; a>=0; a-=3){ servo.write(a); delay(8); }
  currentAngle = 0; // ends at 0; adjust if you prefer to end where it started
}


// ======== LCD helpers ========
void lcdLine(uint8_t r,const String&s){
  lcd.setCursor(0,r);
  String out=s;
  if(out.length()>16) out=out.substring(out.length()-16);
  while(out.length()<16) out+=' ';
  lcd.print(out);
}


void showStatus(){
  if (mode==MODE_PRESET) {
    lcdLine(0, "MODE:PRESET (B)");
  } else if (mode==MODE_TEXT) {
    lcdLine(0, "MODE:TEXT #=SEND");
  } else { // MODE_SERVO
    char top[21];
    snprintf(top, sizeof(top), "MODE:SERVO angle=%3d", currentAngle);
    lcdLine(0, String(top));
  }


  String line;
  if (mode==MODE_TEXT){
    for(uint8_t i=0;i<len;i++) line+=buf[i];
    if(lastKey){
      const char* t=mapKey(lastKey);
      if(t){ line+='_'; line+=t[cycle%strlen(t)]; }
      else if(lastKey=='0') line+="_ ";
    }
  } else if (mode==MODE_PRESET) {
    line = "A=Text  C=Servo";
  } else { // MODE_SERVO
    line = "*/# -/+ 0=CENTER";
  }
  lcdLine(1, line);
}


// ======== IR send (stable, non-repeat frames) ========
inline void sendNEC_byte(uint8_t cmd){
  IrSender.sendNEC(IR_ADDR, cmd, 0); // repeats=0 => full frame
  delay(INTER_CHAR_MS);
}


void commitChar(){
  if(!lastKey) return;
  const char* t=mapKey(lastKey);
  if(t){
    if(len<TEXT_MAX) buf[len++]=t[cycle%strlen(t)];
  } else if(lastKey=='0'){
    if(len<TEXT_MAX) buf[len++]=' ';
  }
  lastKey=0; cycle=0;
}


void sendText(){
  if(lastKey) commitChar();
  if(len==0){ lcdLine(0,"MODE:TEXT (empty)"); return; }


  lcdLine(0,"Sending...");
  sendNEC_byte(IR_TEXT_START);
  for(uint8_t i=0;i<len;i++) sendNEC_byte((uint8_t)buf[i]);
  sendNEC_byte(IR_TEXT_END);


  buf[len]=0; len=0;
  showStatus();
}


// ======== Mode handlers ========
void handlePreset(char k){
  // 1..9 -> presets 1..9, 0 -> preset 10
  int idx = -1;
  if (k>='1' && k<='9') idx = k - '1'; else if (k=='0') idx = 9;
  if (idx < 0 || idx >= 10) return;


  sendNEC_byte(presetCmds[idx]);



  lcdLine(0, "Sent preset " + String(idx+1));
  lcdLine(1, PRESET_TEXT[idx]);
}


void handleText(char k){
  unsigned long now=millis();


  if(k=='#' || k=='D'){ commitChar(); sendText(); showStatus(); return; }
  if(k=='C'){ mode=MODE_SERVO; lastKey=0; cycle=0; showStatus(); return; }
  if(k=='B'){ mode=MODE_PRESET; lastKey=0; cycle=0; showStatus(); return; }


  if(k=='C' || k=='B' || k=='A') return; // mode keys handled above
  if(k=='C') return;


  if(k=='C'){ return; }


  if(k=='C'){ return; }


