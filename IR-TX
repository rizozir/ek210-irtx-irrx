  if(k=='C'){ return; }
 
  if(k=='C'){ return; } // sorry, IDE-safe redundancy :)


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  // regular text editing
  if(k=='C'){ return; }
  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }
 
  if(k=='C'){ return; } // ok back to normal


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='C'){ return; }


  if(k=='*'){ if(lastKey){lastKey=0;cycle=0;} else if(len>0){len--;} showStatus(); return; }
  if(k=='0'){ if(lastKey!='0') commitChar(); lastKey='0'; cycle=0; lastMs=now; showStatus(); return; }


  const char* t=mapKey(k);
  if(t){
    if(k==lastKey && (now-lastMs)<MULTITAP_WINDOW_MS) cycle=(cycle+1)%strlen(t);
    else{ commitChar(); lastKey=k; cycle=0; }
    lastMs=now; showStatus(); return;
  }
}


void handleServo(char k){
  if (k=='A'){ mode=MODE_TEXT;   showStatus(); return; }
  if (k=='B'){ mode=MODE_PRESET; showStatus(); return; }
  if (k=='C'){ /* already servo */ showStatus(); return; }


  if (k=='D'){ // sweep
    lcdLine(0,"SERVO SWEEP");
    lcdLine(1,"");
    servoSweepOnce();
    showStatus();
    return;
  }


  if (k=='*'){ servoSafeWrite(currentAngle - SERVO_NUDGE_STEP); showStatus(); return; }
  if (k=='#'){ servoSafeWrite(currentAngle + SERVO_NUDGE_STEP); showStatus(); return; }


  if (k=='0'){ servoSafeWrite(SERVO_CENTER_ANGLE); showStatus(); return; }


  if (k>='1' && k<='9'){
    int idx = k - '1'; // 0..8
    servoSafeWrite(SERVO_PRESET_ANGLES[idx]);
    showStatus();
    return;
  }
}


void setup(){
  IrSender.begin(IR_PIN, ENABLE_LED_FEEDBACK);
  lcd.begin(16,2);
  lcd.backlight();
  lcd.clear();
  lcdLine(0,"Keypad IR TX Ready");
  lcdLine(1,"A=Text B=Preset C=Servo");
  delay(500);
  showStatus();


  // Servo init (center on startup)
  servo.attach(SERVO_PIN);
  servoSafeWrite(90);
}


void loop(){
  // auto-commit multi-tap if idle (Text mode)
  if(mode==MODE_TEXT && lastKey && (millis()-lastMs)>MULTITAP_WINDOW_MS){
    commitChar(); showStatus();
  }


  char k=keypad.getKey();
  if(!k) return;


  // quick mode toggles (global)
  if (k=='A'){ mode=MODE_TEXT;  lastKey=0; cycle=0; showStatus(); return; }
  if (k=='B'){ mode=MODE_PRESET; lastKey=0; cycle=0; showStatus(); return; }
  if (k=='C'){ mode=MODE_SERVO;  lastKey=0; cycle=0; showStatus(); return; }


  // dispatch by mode
  if      (mode==MODE_PRESET) handlePreset(k);
  else if (mode==MODE_TEXT)   handleText(k);
  else                        handleServo(k);
}
